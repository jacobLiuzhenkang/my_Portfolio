{
  "redirects": [
    {
      "source": "/viform",
      "destination": "https://viform.liuzhenkang.cn/",
      "permanent": false
    },
    {
      "source": "/viform/",
      "destination": "https://viform.liuzhenkang.cn/",
      "permanent": false
    },
    {
      "source": "/viform/privacy.html",
      "destination": "https://viform.liuzhenkang.cn/privacy/",
      "permanent": false
    }
  ],
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "version": 2,
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist/public",
  "installCommand": "npm ci --no-audit --no-fund",
  "regions": [
    "sin1"
  ],
  "functions": {
    "api/**/*.mjs": {
      "maxDuration": 30,
      "includeFiles": "public/downloads/resume-cn.pdf"
    }
  },
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "/api"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/api/:path*",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    },
    {
      "source": "/:path*",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        }
      ]
    },
    {
      "source": "/((?!downloads/[^/]+\\.[pP][dD][fF]$).*)",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self' https://vercel.live; style-src 'self' 'unsafe-inline'; img-src 'self' blob: data: https:; font-src 'self' data:; connect-src 'self' https://*.blob.vercel-storage.com https://vercel.com/api/blob/ https://vercel.live wss://vercel.live; worker-src 'self' blob:; frame-ancestors 'none'; base-uri 'self'; form-action 'self'; object-src 'none'"
        }
      ]
    },
    {
      "source": "/downloads/([^/]+\\.[pP][dD][fF])",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "frame-ancestors 'self'"
        }
      ]
    }
  ],
  "env": {
    "NODEJS_HELPERS": "0"
  }
}
