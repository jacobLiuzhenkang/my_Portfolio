# ── Backend ─────────────────────────────────────────────────────
# No platform APP_ID or APP_SECRET is needed.

# ── Database ───────────────────────────────────────────────────
DATABASE_URL=             # PostgreSQL connection string, injected by Neon on Vercel

# Private Vercel Blob; connected deployments use BLOB_STORE_ID + OIDC.
BLOB_STORE_ID=
# Optional, server-only local development credential; never expose to the client.
BLOB_READ_WRITE_TOKEN=
